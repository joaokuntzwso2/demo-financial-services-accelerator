+            String serializedResponseTypes =
+                    ((String) responseTypes).trim();
+
+            if (serializedResponseTypes.startsWith("[") &&
+                    serializedResponseTypes.endsWith("]")) {
+
+                String values = serializedResponseTypes
+                        .substring(
+                                1,
+                                serializedResponseTypes.length() - 1)
+                        .trim();
+
+                List<String> responseTypeList = new ArrayList<>();
+
+                if (!values.isEmpty()) {
+                    for (String responseType :
+                            values.split(",\\s*")) {
+
+                        responseTypeList.add(responseType);
+                    }
+                }
+
+                filteredAttributes.put(
