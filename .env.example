# Supported Financial Services Accelerator 4.0 baseline
APIM_VERSION=4.6.0
IS_VERSION=7.2.0
FS_ACCELERATOR_VERSION=4.0.0
FS_APIM_MEDIATION_POLICIES_VERSION=1.0.0

# Open Banking 4.0 packaging:
#   IAM Accelerator -> Identity Server
#   Financial Services mediation policies -> API Manager
# IAM input mode: release | local
ACCELERATOR_SOURCE_MODE=release

# APIM mediation-policy input mode: source | local
APIM_POLICIES_SOURCE_MODE=source
FS_APIM_MEDIATION_POLICIES_GIT_REF=v1.0.0

# Demo credentials only
WSO2_ADMIN_USER=admin
WSO2_ADMIN_PASSWORD=admin
MYSQL_ROOT_PASSWORD=root
MYSQL_APP_USER=wso2
MYSQL_APP_PASSWORD=wso2

# Supported baseline; no experimental compatibility override is required.
ALLOW_UNSUPPORTED_WSO2_COMBINATION=false

# MySQL Connector/J chosen for MySQL 8.0 and modern WSO2/Java runtime
MYSQL_CONNECTOR_VERSION=8.0.33
NOTIFICATION_HANDLER_VERSION=2.1.3

# Host ports
APIM_HTTPS_PORT=9443
APIM_GATEWAY_HTTPS_PORT=8243
IS_HTTPS_PORT=9446
BANK_BACKEND_PORT=8080
MYSQL_HOST_PORT=33060
